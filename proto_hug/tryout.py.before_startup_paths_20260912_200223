import json
import time
import threading
import numpy as np
from pathlib import Path
from bbos import Reader, Writer, Type, Config

# control whether to record baseline torque and write to hug-torque.json
DRY_RUN = False

RECORDING = Path(__file__).parent / "hug.json"

LEFT_CFG = Config("arm_left")
RIGHT_CFG = Config("arm_right")
DOF = LEFT_CFG.dof

baseline_torque : list = []
with open("hug-torque.json", 'r') as file:
    baseline_torque = json.load(file)

baseline_torque_np: np.array = np.array(baseline_torque)


def scan(readers, controls, frames, configs):
    """Back out, lower J0, re-contact; all positions are motor turns."""
    path = np.array([f['left'] for f in frames], dtype=float)
    limits = [json.loads((Path(c.urdf_path).parent.parent / 'ranges.calibration.json').read_text()) for c in configs]
    lo = np.array([np.minimum(c['cal_min'], c['cal_max']) for c in limits])
    hi = np.array([np.maximum(c['cal_min'], c['cal_max']) for c in limits])
    bottom = np.array([hi[0, 0] - 0.02, lo[1, 0] + 0.02])
    step = 0.20 / (2 * np.pi * np.array([c.wheel_radius for c in configs]))
    level = None
    direction = path[-1, 1:4] - path[750, 1:4]
    direction /= max(np.max(np.abs(direction)), 1e-6)
    baseline = baseline_torque_np.copy()
    for side in range(2):
        valid = np.isfinite(baseline[:, side]) & (baseline[:, side] != -1)
        if not valid.any(): raise RuntimeError('No valid contact baseline')
        baseline[:, side] = np.interp(np.arange(len(baseline)), np.flatnonzero(valid), baseline[valid, side])
    states, fresh, seen = [None, None], [False, False], [time.monotonic()] * 2
    stage, source, start = 'out', None, time.monotonic()
    while time.monotonic() - start < 300:
        time.sleep(0.02)
        for side, reader in enumerate(readers):
            if reader.ready():
                states[side], fresh[side], seen[side] = reader.data.copy(), True, time.monotonic()
        if time.monotonic() - min(seen) > 0.2: raise RuntimeError('Arm feedback stopped')
        if not all(fresh): continue
        fresh[:] = [False, False]
        q = np.array([s['pos'] for s in states])
        current = np.array([s['current'] for s in states])
        torque = np.array([s['torque'] for s in states])
        if not all(np.isfinite(a).all() for a in (q, current, torque)): raise RuntimeError('Invalid arm feedback')
        if np.any(np.abs(current) >= np.array([c.hard_current_limit for c in configs])): raise RuntimeError('Arm current limit')
        indices = [750 + np.argmin(np.linalg.norm(path[750:, 1:4] - sign*q[side, 1:4], axis=1)) for side, sign in enumerate((1, -1))]
        base = np.array([baseline[min(i, len(baseline)-1), side] for side, i in enumerate(indices)])
        load = np.abs(torque[:, 1:6].mean(axis=1) - base) / np.maximum(np.abs(base), 0.05)
        if source is None:
            source, target, began = q.copy(), q.copy(), time.monotonic()
            print('Contour:', stage, 'J0:', q[:, 0], flush=True)
            if stage == 'out': target[:, 1:4] -= np.array([[1], [-1]]) * direction * 0.03
            elif stage == 'down':
                if level is None: level = np.array([min(q[0, 0] + step[0], bottom[0]), max(q[1, 0] - step[1], bottom[1])])
                target[:, 0] = level
            else: target[:, 1:4] = np.array([path[-1, 1:4], -path[-1, 1:4]])
            target[:, 1:7] = np.clip(target[:, 1:7], lo[:, 1:7], hi[:, 1:7])
        if stage in ('in', 'down') and np.any(load > 0.15):
            print('CONTACT -> out; side:', np.flatnonzero(load > 0.15).tolist(), 'load:', load, flush=True)
            stage, source = 'out', None
            continue
        duration = {'out': 1.2, 'down': 8.0, 'in': 4.0}[stage]
        u = min((time.monotonic() - began) / duration, 1.0)
        command = source + (target - source) * (10*u**3 - 15*u**4 + 6*u**5)
        for writer, position in zip(controls, command): writer['pos'] = position.astype(np.float32)
        settled = np.max(np.abs(q[:, :7] - target[:, :7])) < 0.003
        if u == 1 and settled and stage != 'in':
            if stage == 'out' and np.any(load > 0.10):
                if time.monotonic() - began > duration + 1: raise RuntimeError('Contact did not release; J0 held')
                continue
            if stage == 'out' and np.all(np.abs(q[:, 0] - bottom) < 0.003): return
            if stage == 'down': level = None
            stage, source = ('down' if stage == 'out' else 'in'), None
        elif time.monotonic() - began > duration + 1:
            raise RuntimeError('No contact within recorded reach' if stage == 'in' else 'Arm did not reach target')
    raise RuntimeError('Contour timeout')


def main():
    with open(RECORDING) as f:
        data = json.load(f)

    frames = data["frames"]
    if not frames:
        print("No frames in recording.")
        return

    print(f"Loaded '{data.get('name', 'hug_final')}' — {len(frames)} frames, {frames[-1]['t']:.1f}s")

    torque_baseline = []
    left_active = True
    right_active = True

    with (
        Reader("arm_left.state", keeptime=False) as r_left,
        Reader("arm_right.state", keeptime=False) as r_right,
        Writer("arm_left.ctrl", Type("arm_ctrl"), keeptime=False) as w_left,
        Writer("arm_right.ctrl", Type("arm_ctrl"), keeptime=False) as w_right,
        Writer("arm_left.torque", Type("arm_torque"), keeptime=False) as w_torque_left,
        Writer("arm_right.torque", Type("arm_torque"), keeptime=False) as w_torque_right,
    ):
        try:
            # Snap to first frame position before enabling torque
            w_torque_left['enable'] = np.zeros(DOF, dtype=np.bool_)
            w_torque_right['enable'] = np.zeros(DOF, dtype=np.bool_)
            time.sleep(0.1)

            w_left['pos'] = np.zeros(DOF, dtype=np.float32)
            w_right['pos'] = np.zeros(DOF, dtype=np.float32)
            time.sleep(0.1)

            w_torque_left['enable'] = np.ones(DOF, dtype=np.bool_)
            w_torque_right['enable'] = np.ones(DOF, dtype=np.bool_)
            time.sleep(0.1)

            print("Playing...")
            t0 = time.time()
            for i in range(len(frames)):
                target = t0 + frames[i]["t"]
                now = time.time()
                if target > now:
                    time.sleep(target - now)
                torque_left = -1
                torque_right = -1
                if r_left.ready():
                    torque_left = float(np.average(r_left.data['torque'][1:6]))
                if r_right.ready():
                    torque_right = float(np.average(r_right.data['torque'][1:6]))
                if DRY_RUN:
                    torque_baseline.append([torque_left, torque_right])
                else:
                    base = baseline_torque_np[i] if i < len(baseline_torque_np) else (-1, -1)
                    left_spike = torque_left != -1 and base[0] != -1 and abs(base[0] - torque_left) > 0.15 * max(abs(base[0]), 0.05)
                    right_spike = torque_right != -1 and base[1] != -1 and abs(base[1] - torque_right) > 0.15 * max(abs(base[1]), 0.05)
                    if left_spike or right_spike:
                        left_active, right_active = not left_spike, not right_spike
                        print('CONTACT -> out; left:', left_spike, 'right:', right_spike, 'frame:', i, flush=True)
                        break

                if left_active:
                    w_left['pos'] = np.array(frames[i]["left"], dtype=np.float32)
                if right_active:
                    w_right['pos'] = -np.array(frames[i]["left"], dtype=np.float32)

            if not DRY_RUN:
                if left_active and right_active:
                    raise RuntimeError('Playback ended without detected contact')
                scan((r_left, r_right), (w_left, w_right), frames, (LEFT_CFG, RIGHT_CFG))
            print("Done.")
        finally:
            for writer in (w_torque_left, w_torque_right):
                try:
                    writer['enable'] = np.zeros(DOF, dtype=np.bool_)
                except Exception as error:
                    print('Torque-off request failed:', error)

    if DRY_RUN:
        open("hug-torque.json", "w").write(json.dumps(torque_baseline))

if __name__ == "__main__":
    main()
