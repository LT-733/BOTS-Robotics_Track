import json
import time
from pathlib import Path

import numpy as np
from bbos import Config, Reader, Type, Writer

RECORDING = Path(__file__).parent / "hug.json"
LEFT_CFG, RIGHT_CFG = Config("arm_left"), Config("arm_right")
DOF = LEFT_CFG.dof
SHUTDOWN_TORQUE_NM = 1.30


def main():
    frames = json.loads(RECORDING.read_text())["frames"]
    if not frames:
        print("No frames in recording.")
        return
    print(f"Loaded hug — {len(frames)} frames, {frames[-1]['t']:.1f}s")

    with (
        Reader("arm_left.state", keeptime=False) as r_left,
        Reader("arm_right.state", keeptime=False) as r_right,
        Writer("arm_left.ctrl", Type("arm_ctrl"), keeptime=False) as w_left,
        Writer("arm_right.ctrl", Type("arm_ctrl"), keeptime=False) as w_right,
        Writer("arm_left.torque", Type("arm_torque"), keeptime=False) as wt_left,
        Writer("arm_right.torque", Type("arm_torque"), keeptime=False) as wt_right,
    ):
        off = np.zeros(DOF, dtype=np.bool_)
        on = np.ones(DOF, dtype=np.bool_)

        def shutdown():
            for _ in range(3):
                wt_left["enable"], wt_right["enable"] = off, off
                time.sleep(0.01)

        try:
            shutdown()
            w_left["pos"] = np.zeros(DOF, dtype=np.float32)
            w_right["pos"] = np.zeros(DOF, dtype=np.float32)
            time.sleep(0.1)
            wt_left["enable"], wt_right["enable"] = on, on
            time.sleep(0.5)
            if not (r_left.ready() and r_right.ready()):
                raise RuntimeError("Arm feedback unavailable")

            kt = (np.asarray(LEFT_CFG.kt, dtype=float),
                  np.asarray(RIGHT_CFG.kt, dtype=float))
            readers = (r_left, r_right)
            first_peak_seen = False
            valley_started = None
            armed = False

            print("Playing — first lift peak is allowed")
            t0 = time.monotonic()
            for frame in frames:
                delay = t0+frame["t"]-time.monotonic()
                if delay > 0:
                    time.sleep(delay)

                torques = []
                for reader, motor_kt in zip(readers, kt):
                    current = np.asarray(reader.data["current"], dtype=float)
                    if not np.all(np.isfinite(current)):
                        raise RuntimeError("Invalid motor-current feedback")
                    torques.append(np.abs(current*motor_kt))
                peak = max(float(np.max(t[1:7])) for t in torques)

                # Identify the first peak and the valley after it from the live signal.
                if not first_peak_seen and peak >= 0.50*SHUTDOWN_TORQUE_NM:
                    first_peak_seen = True
                    print("First lift peak detected — shutdown still disabled")
                elif first_peak_seen and not armed:
                    if peak <= 0.35*SHUTDOWN_TORQUE_NM:
                        valley_started = valley_started or time.monotonic()
                        if time.monotonic()-valley_started >= 0.10:
                            armed = True
                            print("Lift peak finished — 1.30 Nm shutdown ARMED")
                    else:
                        valley_started = None

                if armed:
                    for side, torque in enumerate(torques):
                        joint = int(np.argmax(torque[1:7]))+1
                        if torque[joint] >= SHUTDOWN_TORQUE_NM:
                            shutdown()
                            print(f"SHUTDOWN: {'left' if side == 0 else 'right'} J{joint} = {torque[joint]:.3f} Nm")
                            print("Both arms torque-off; process exiting.")
                            return

                # Safety decision happens before either new position is written.
                w_left["pos"] = np.asarray(frame["left"], dtype=np.float32)
                w_right["pos"] = -np.asarray(frame["left"], dtype=np.float32)

            print("Playback completed without reaching 1.30 Nm after the lift.")
        finally:
            shutdown()


if __name__ == "__main__":
    main()
