import json
import math
import time
import numpy as np
from pathlib import Path
from bbos import Reader, Writer, Type, Config

RECORDING = Path(__file__).parent / "hug.json"
LEFT_CFG = Config("arm_left")
RIGHT_CFG = Config("arm_right")
DOF = LEFT_CFG.dof
TOUCH_TORQUE_NM, HARD_AMPS = 1.25, 1.20

def main():
    with open(RECORDING) as f:
        data = json.load(f)
    frames = data["frames"]
    if not frames:
        print("No frames in recording.")
        return
    print(f"Loaded '{data.get('name', 'hug_final')}' — {len(frames)} frames, {frames[-1]['t']:.1f}s")

    with (
        Reader("arm_left.state", keeptime=False) as r_left,
        Reader("arm_right.state", keeptime=False) as r_right,
        Writer("arm_left.ctrl", Type("arm_ctrl"), keeptime=False) as w_left,
        Writer("arm_right.ctrl", Type("arm_ctrl"), keeptime=False) as w_right,
        Writer("arm_left.torque", Type("arm_torque"), keeptime=False) as w_torque_left,
        Writer("arm_right.torque", Type("arm_torque"), keeptime=False) as w_torque_right,
    ):
        w_torque_left['enable'] = np.zeros(DOF, dtype=np.bool_)
        w_torque_right['enable'] = np.zeros(DOF, dtype=np.bool_)
        time.sleep(0.1)
        w_left['pos'] = np.zeros(DOF, dtype=np.float32)
        w_right['pos'] = np.zeros(DOF, dtype=np.float32)
        time.sleep(0.1)
        w_torque_left['enable'] = np.ones(DOF, dtype=np.bool_)
        w_torque_right['enable'] = np.ones(DOF, dtype=np.bool_)
        time.sleep(0.5)

        if not (r_left.ready() and r_right.ready()):
            raise RuntimeError("Arm feedback unavailable")
        kt = [np.asarray(LEFT_CFG.kt, dtype=float), np.asarray(RIGHT_CFG.kt, dtype=float)]
        base_torque = [np.array(r_left.data['current'], dtype=float)*kt[0],
                       np.array(r_right.data['current'], dtype=float)*kt[1]]
        touched = [False, False]

        def feel_touch(enabled):
            for side, state in enumerate((r_left.data, r_right.data)):
                current = np.array(state['current'], dtype=float)
                if not np.all(np.isfinite(current)) or np.max(np.abs(current[1:7])) >= HARD_AMPS:
                    w_torque_left['enable'] = np.zeros(DOF, dtype=np.bool_)
                    w_torque_right['enable'] = np.zeros(DOF, dtype=np.bool_)
                    raise RuntimeError("Invalid or excessive arm current")
                delta = np.abs(current*kt[side] - base_torque[side])
                if enabled and np.max(delta[1:7]) >= TOUCH_TORQUE_NM:
                    joint = int(np.argmax(delta[1:7])) + 1
                    touched[:] = [True, True]
                    print(f"Torque stop latched: {'left' if side == 0 else 'right'} J{joint} = {delta[joint]:.2f} Nm")

        print("Playing...")
        t0 = time.time()
        for frame in frames:
            target = t0 + frame["t"]
            if target > time.time():
                time.sleep(target - time.time())
            at_top = frame["t"] >= 2.5 and abs(frame["left"][0]-frames[-1]["left"][0]) < 0.0005
            feel_touch(at_top)
            if not touched[0]:
                w_left['pos'] = np.array(frame["left"], dtype=np.float32)
            if not touched[1]:
                w_right['pos'] = -np.array(frame["left"], dtype=np.float32)
            if all(touched):
                break

        hug_left = np.array(r_left.data['pos'], dtype=np.float32)
        hug_right = np.array(r_right.data['pos'], dtype=np.float32)

        # Continue hug.json's inward arm path. Joint 7 (the fingers) never moves.
        old = next(f for f in reversed(frames) if f["t"] <= frames[-1]["t"] - 2.0)
        inward = np.array(frames[-1]["left"], dtype=float) - np.array(old["left"], dtype=float)
        inward[[0, 7]] = 0.0
        inward *= 0.0003 / max(np.max(np.abs(inward)), 1e-9)
        for _ in range(200):
            feel_touch(True)
            for side, pose, step in ((0, hug_left, inward), (1, hug_right, -inward)):
                if not touched[side]:
                    pose[1:7] += step[1:7]
            w_left['pos'], w_right['pos'] = hug_left.copy(), hug_right.copy()
            if all(touched):
                break
            time.sleep(0.02)

        if not all(touched):
            print("No contact detected — inward clasp completed")

        print("Touch detected — moving arms up and down")
        left_j0, right_j0 = float(hug_left[0]), float(hug_right[0])
        for n in range(450):
            offset = 0.03 * math.sin(2 * math.pi * n * 0.01 / 1.5)
            hug_left[0], hug_right[0] = left_j0-offset, right_j0+offset
            w_left['pos'], w_right['pos'] = hug_left.copy(), hug_right.copy()
            time.sleep(0.01)

        w_torque_left['enable'] = np.zeros(DOF, dtype=np.bool_)
        w_torque_right['enable'] = np.zeros(DOF, dtype=np.bool_)
        print("Done.")

if __name__ == "__main__":
    main()
