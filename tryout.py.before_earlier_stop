import json
import time
from pathlib import Path
from statistics import NormalDist

import numpy as np
from bbos import Config, Reader, Type, Writer

RECORDING = Path(__file__).parent / "hug.json"
LEFT_CFG, RIGHT_CFG = Config("arm_left"), Config("arm_right")
DOF = LEFT_CFG.dof
FALSE_ALARM_PROBABILITY = 1e-4


def lift_end_frame(frames):
    """Find when J0 reaches its final level; no torque threshold is used."""
    j0 = np.array([f["left"][0] for f in frames], dtype=float)
    tail = j0[-max(20, len(j0)//10):]
    final = float(np.median(tail))
    mad = float(np.median(np.abs(tail-final)))
    encoder_step = abs(float(getattr(LEFT_CFG, "j0_increment", 6/4096)))/6
    tolerance = max(6*1.4826*mad, 3*encoder_step)
    outside = np.flatnonzero(np.abs(j0-final) > tolerance)
    return int(outside[-1]+1) if len(outside) else 0


def main():
    frames = json.loads(RECORDING.read_text())["frames"]
    if not frames:
        print("No frames in recording.")
        return
    arm_at = lift_end_frame(frames)
    print(f"Loaded hug — {len(frames)} frames, {frames[-1]['t']:.1f}s")
    print(f"Torque recognition will arm after lift settles at {frames[arm_at]['t']:.2f}s")

    with (
        Reader("arm_left.state", keeptime=False) as r_left,
        Reader("arm_right.state", keeptime=False) as r_right,
        Writer("arm_left.ctrl", Type("arm_ctrl"), keeptime=False) as w_left,
        Writer("arm_right.ctrl", Type("arm_ctrl"), keeptime=False) as w_right,
        Writer("arm_left.torque", Type("arm_torque"), keeptime=False) as wt_left,
        Writer("arm_right.torque", Type("arm_torque"), keeptime=False) as wt_right,
    ):
        disabled = np.zeros(DOF, dtype=np.bool_)
        enabled = np.ones(DOF, dtype=np.bool_)

        def stop_motors():
            for _ in range(3):
                wt_left["enable"], wt_right["enable"] = disabled, disabled
                time.sleep(0.01)

        try:
            stop_motors()
            time.sleep(0.1)
            w_left["pos"] = np.zeros(DOF, dtype=np.float32)
            w_right["pos"] = np.zeros(DOF, dtype=np.float32)
            time.sleep(0.1)
            wt_left["enable"], wt_right["enable"] = enabled, enabled
            time.sleep(0.5)
            if not (r_left.ready() and r_right.ready()):
                raise RuntimeError("Arm feedback unavailable")

            cfgs = (LEFT_CFG, RIGHT_CFG)
            readers = (r_left, r_right)
            kt = [np.asarray(c.kt, dtype=float) for c in cfgs]
            baseline = [[], []]
            mean, sigma = [None, None], [None, None]
            z_limit = NormalDist().inv_cdf(1-FALSE_ALARM_PROBABILITY/(2*12))
            recognition_ready = False

            print("Playing lift with contact recognition disabled...")
            t0 = time.monotonic()
            for index, frame in enumerate(frames):
                delay = t0 + frame["t"] - time.monotonic()
                if delay > 0:
                    time.sleep(delay)

                armed = index >= arm_at
                detected = None

                if armed and not recognition_ready:
                    for side in (0, 1):
                        samples = np.stack(baseline[side][-20:])
                        mean[side] = np.median(samples, axis=0)
                        noise = 1.4826*np.median(np.abs(samples-mean[side]), axis=0)
                        sigma[side] = np.maximum(noise, 0.0065*kt[side])
                    recognition_ready = True
                    print("Lift settled — fixed-baseline torque recognition ARMED")

                for side, (reader, cfg) in enumerate(zip(readers, cfgs)):
                    current = np.asarray(reader.data["current"], dtype=float)
                    hard = np.asarray(cfg.hard_current_limit, dtype=float)
                    if not np.all(np.isfinite(current)) or np.any(np.abs(current) >= hard):
                        raise RuntimeError("Invalid feedback or hardware current limit")

                    torque = current*kt[side]
                    if not armed:
                        baseline[side].append(torque.copy())
                        continue
                    error = torque-mean[side]
                    z = np.abs(error)/sigma[side]
                    joint = int(np.argmax(z[1:7]))+1
                    if z[joint] >= z_limit:
                        detected = side, joint, float(z[joint]), float(torque[joint])
                        break

                if detected:
                    side, joint, z, torque = detected
                    stop_motors()
                    print(f"CONTACT: {'left' if side == 0 else 'right'} J{joint}, z={z:.1f}, torque={torque:.3f} Nm")
                    print("Both arms stopped; process exiting.")
                    return

                w_left["pos"] = np.asarray(frame["left"], dtype=np.float32)
                w_right["pos"] = -np.asarray(frame["left"], dtype=np.float32)

            print("Playback completed without a contact anomaly.")
        finally:
            stop_motors()


if __name__ == "__main__":
    main()
